NODE_ENV=production
PORT=5000

# Create a new least-privilege MongoDB user. Never reuse the exposed credential.
MONGODB_URI=replace_with_the_new_server_only_connection_string

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace_with_a_new_random_secret_of_at_least_32_characters

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=replace_with_a_base64_encoded_32_byte_key

# Comma-separated website-admin emails allowed to create/update/delete admins.
ADMIN_OWNER_EMAILS=owner@example.com

# Usually leave unset so the cookie is host-only on api.ansaritools.com.
# ADMIN_COOKIE_DOMAIN=.ansaritools.com
# LEGACY_ADMIN_COOKIE_DOMAIN=.ansaritools.com

# Extra trusted frontend origins, comma-separated. Production domains are built in.
# ALLOWED_ORIGINS=https://preview.example.com

# Public dashboard signup is disabled unless explicitly enabled.
ALLOW_PUBLIC_SIGNUP=false

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
EMAIL_USER=
EMAIL_PASS=
